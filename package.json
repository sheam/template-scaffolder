{
  "name": "template-scaffolder",
  "version": "3.0.0",
  "description": "Multi-file scaffolding from Velocity templates, with source readers for TypeScript, C# and C++.",
  "keywords": [
    "typescript",
    "javascript",
    "command-line",
    "cli",
    "devops",
    "command",
    "development",
    "devtools",
    "scaffolding",
    "templates",
    "automation",
    "velocity",
    "codegen",
    "tree-sitter",
    "csharp",
    "cpp"
  ],
  "repository": "https://github.com/sheam/template-scaffolder",
  "author": "Shea Martin",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./source": {
      "types": "./dist/source/index.d.ts",
      "default": "./dist/source/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "scaffolder": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "grammars",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "npm run build:clean && tsc -p tsconfig.build.json && node scripts/copy-grammars.mjs",
    "build:clean": "rimraf dist grammars",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test docs/examples",
    "lint:fix": "eslint --fix src test docs/examples",
    "format": "prettier --write src test docs scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:characterization": "npm run build && vitest run test/characterization",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm run check"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "jiti": "^2.7.0",
    "picomatch": "^4.0.7",
    "velocityjs": "^2.0.6",
    "web-tree-sitter": "0.27.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
