{
  "name": "template-scaffolder",
  "repository": "https://github.com/sheam/template-scaffolder",
  "version": "2.3.12",
  "description": "multi-file scaffolding with velocity template for any type of project",
  "keywords": [
    "typescript",
    "javascript",
    "command-line",
    "cli",
    "devops",
    "command",
    "development",
    "devtools",
    "scaffolding",
    "templates",
    "automation"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "types": "dist/index.d.ts",
  "bin": {
    "scaffolder": "./dist/exe/index.js"
  },
  "scripts": {
    "build": "npm run build:clean && npm run build:exe && npm run build:types",
    "build:clean": "rimraf dist",
    "build:exe": "tsc",
    "build:types": "tsc --project ./tsconfig.types.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "lint:fix": "eslint --fix src test",
    "format": "prettier --write src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:characterization": "npm run build && vitest run test/characterization",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm run check"
  },
  "author": "Shea Martin",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^6.0.1",
    "config-file-ts-async": "^1.0.7",
    "node-cli-arg-by-config": "^0.11.0",
    "velocityjs": "^2.0.6"
  }
}
