{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true,
    "paths": {
      "template-scaffolder/source": ["./src/source/index.ts"],
      "template-scaffolder": ["./src/index.ts"]
    }
  },
  "include": ["src", "test", "docs/examples", "vitest.config.ts"],
  "exclude": ["test/fixtures"]
}
